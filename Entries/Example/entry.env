# Entrant-declared artifact aliases; parsed as data, never sourced.
ENTRY_FORMAT=self-extracting
EXECUTION_PLATFORM=linux-x86_64
SOURCE_PACKAGE=example-source.tar.gz
COMPRESSOR=cmix
COMPRESSOR_FORMAT=upx-overlay
COMPRESSOR_ARGUMENTS=comp9.args
ARCHIVE=archive9
ARCHIVE_FORMAT=executable
DECOMPRESSED_OUTPUT=enwik9_uncompressed
