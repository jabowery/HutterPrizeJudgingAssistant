#!/usr/bin/env bash

hp_runtime_policy_validate() {
  case "$1" in
    strict|process-tree) ;;
    *)
      echo "RUNTIME_EXEC_POLICY must be strict or process-tree." >&2
      return 2
      ;;
  esac
}

hp_open_monitor_descriptors() {
  local hp_rr_report_dir="$1"
  : > "$hp_rr_report_dir/execution-events.tsv"
  : > "$hp_rr_report_dir/process_tree_peak_rss_bytes"
  : > "$hp_rr_report_dir/process_tree_memory_exceeded"
  exec 9</proc
  exec 8>"$hp_rr_report_dir/execution-events.tsv"
  exec 7>"$hp_rr_report_dir/process_tree_peak_rss_bytes"
  exec 6>"$hp_rr_report_dir/process_tree_memory_exceeded"
  chmod 0400 "$hp_rr_report_dir/execution-events.tsv" \
    "$hp_rr_report_dir/process_tree_peak_rss_bytes" \
    "$hp_rr_report_dir/process_tree_memory_exceeded"
}

hp_close_monitor_descriptors() {
  exec 9<&-
  exec 8>&-
  exec 7>&-
  exec 6>&-
}

hp_read_cgroup_peak() {
  if [[ -r /sys/fs/cgroup/memory.peak ]]; then
    tr -d '\r\n' < /sys/fs/cgroup/memory.peak
    return
  fi
  if [[ -r /sys/fs/cgroup/memory/memory.max_usage_in_bytes ]]; then
    tr -d '\r\n' < /sys/fs/cgroup/memory/memory.max_usage_in_bytes
    return
  fi
  printf 'unavailable\n'
}

hp_cgroup_peak_source() {
  if [[ -r /sys/fs/cgroup/memory.peak ]]; then
    printf 'cgroup-v2-memory.peak\n'
  elif [[ -r /sys/fs/cgroup/memory/memory.max_usage_in_bytes ]]; then
    printf 'cgroup-v1-memory.max_usage_in_bytes\n'
  else
    printf 'unavailable\n'
  fi
}

hp_read_cgroup_current() {
  if [[ -r /sys/fs/cgroup/memory.current ]]; then
    tr -d '\r\n' < /sys/fs/cgroup/memory.current
    return
  fi
  if [[ -r /sys/fs/cgroup/memory/memory.usage_in_bytes ]]; then
    tr -d '\r\n' < /sys/fs/cgroup/memory/memory.usage_in_bytes
    return
  fi
  printf 'unavailable\n'
}

hp_read_cgroup_cpu_usage_usec() {
  local usage_usec
  if [[ -r /sys/fs/cgroup/cpu.stat ]]; then
    usage_usec="$(awk '$1 == "usage_usec" { print $2 }' /sys/fs/cgroup/cpu.stat)"
    [[ "$usage_usec" =~ ^[0-9]+$ ]] && {
      printf '%s\n' "$usage_usec"
      return
    }
  fi
  if [[ -r /sys/fs/cgroup/cpuacct/cpuacct.usage ]]; then
    usage_usec="$(tr -d '\r\n' < /sys/fs/cgroup/cpuacct/cpuacct.usage)"
    if [[ "$usage_usec" =~ ^[0-9]+$ ]]; then
      printf '%s\n' "$((usage_usec / 1000))"
      return
    fi
  fi
  printf 'unavailable\n'
}

hp_format_gib_runtime() {
  LC_ALL=C awk -v bytes="$1" '
    BEGIN {
      value = sprintf("%.10f", bytes / 1073741824)
      sub(/0+$/, "", value)
      sub(/[.]$/, "", value)
      printf "%s GiB", value
    }
  '
}

hp_format_gb_runtime() {
  LC_ALL=C awk -v bytes="$1" '
    BEGIN {
      value = sprintf("%.9f", bytes / 1000000000)
      sub(/0+$/, "", value)
      sub(/[.]$/, "", value)
      printf "%s GB", value
    }
  '
}

hp_format_hms_runtime() {
  local total_seconds="$1"
  local hours minutes seconds
  hours="$((10#$total_seconds / 3600))"
  minutes="$(((10#$total_seconds % 3600) / 60))"
  seconds="$((10#$total_seconds % 60))"
  printf '%02d:%02d:%02d' "$hours" "$minutes" "$seconds"
}

hp_format_signed_hms_runtime() {
  local hp_rr_signed_seconds="$1" hp_rr_sign=+
  if (( hp_rr_signed_seconds < 0 )); then
    hp_rr_sign=-
    hp_rr_signed_seconds="$((-hp_rr_signed_seconds))"
  fi
  printf '%s%s' "$hp_rr_sign" "$(hp_format_hms_runtime "$hp_rr_signed_seconds")"
}

hp_emit_runtime_status() {
  local hp_rr_start_epoch="$1"
  local hp_rr_deadline_epoch="$2"
  local hp_rr_disk_bytes="$3"
  local hp_rr_disk_limit_bytes="$4"
  local hp_rr_cgroup_limit_bytes="$5"
  local hp_rr_output_path="$6"
  local hp_rr_cgroup_cpu_start_usec="$7"
  local hp_rr_expected_output_bytes="${8:-unavailable}"
  local hp_rr_now_epoch hp_rr_elapsed_seconds hp_rr_remaining_seconds
  local hp_rr_cgroup_current hp_rr_cgroup_cpu_current_usec
  local hp_rr_cpu_elapsed_seconds hp_rr_output_state hp_rr_output_bytes
  local hp_rr_progress hp_rr_projected_seconds hp_rr_projection_margin
  local hp_rr_allowance_seconds

  hp_rr_now_epoch="$(date +%s)"
  hp_rr_elapsed_seconds="$((hp_rr_now_epoch - hp_rr_start_epoch))"
  (( hp_rr_elapsed_seconds >= 0 )) || hp_rr_elapsed_seconds=0
  hp_rr_remaining_seconds="$((hp_rr_deadline_epoch - hp_rr_now_epoch))"
  (( hp_rr_remaining_seconds >= 0 )) || hp_rr_remaining_seconds=0
  hp_rr_cgroup_current="$(hp_read_cgroup_current)"
  if [[ "$hp_rr_cgroup_current" =~ ^[0-9]+$ ]]; then
    hp_rr_cgroup_current="$(hp_format_gib_runtime "$hp_rr_cgroup_current")"
  fi
  hp_rr_cgroup_cpu_current_usec="$(hp_read_cgroup_cpu_usage_usec)"
  if [[ "$hp_rr_cgroup_cpu_start_usec" =~ ^[0-9]+$ \
      && "$hp_rr_cgroup_cpu_current_usec" =~ ^[0-9]+$ ]]; then
    hp_rr_cpu_elapsed_seconds="$(((hp_rr_cgroup_cpu_current_usec - hp_rr_cgroup_cpu_start_usec) / 1000000))"
    (( hp_rr_cpu_elapsed_seconds >= 0 )) || hp_rr_cpu_elapsed_seconds=0
    hp_rr_cgroup_cpu_current_usec="$(hp_format_hms_runtime "$hp_rr_cpu_elapsed_seconds")"
  else
    hp_rr_cgroup_cpu_current_usec=unavailable
  fi
  if [[ -f "$hp_rr_output_path" && ! -L "$hp_rr_output_path" ]]; then
    hp_rr_output_bytes="$(stat --format='%s' -- "$hp_rr_output_path")"
    hp_rr_output_state="$(basename -- "$hp_rr_output_path")=$hp_rr_output_bytes bytes"
  else
    hp_rr_output_bytes=unavailable
    hp_rr_output_state="$(basename -- "$hp_rr_output_path")=not-created"
  fi

  hp_rr_progress=unavailable
  hp_rr_projected_seconds=unavailable
  hp_rr_projection_margin=unavailable
  if [[ "$hp_rr_expected_output_bytes" =~ ^[1-9][0-9]*$ \
      && "$hp_rr_output_bytes" =~ ^[1-9][0-9]*$ \
      && "$hp_rr_elapsed_seconds" -gt 0 ]]; then
    hp_rr_progress="$(LC_ALL=C awk \
      -v current="$hp_rr_output_bytes" -v expected="$hp_rr_expected_output_bytes" \
      'BEGIN { printf "%.2f%%", 100 * current / expected }')"
    hp_rr_projected_seconds="$(LC_ALL=C awk \
      -v elapsed="$hp_rr_elapsed_seconds" -v current="$hp_rr_output_bytes" \
      -v expected="$hp_rr_expected_output_bytes" \
      'BEGIN { print int(elapsed * expected / current + 0.999999) }')"
    hp_rr_allowance_seconds="$((hp_rr_deadline_epoch - hp_rr_start_epoch))"
    (( hp_rr_allowance_seconds >= 0 )) || hp_rr_allowance_seconds=0
    hp_rr_projection_margin="$((hp_rr_allowance_seconds - hp_rr_projected_seconds))"
    hp_rr_projected_seconds="$(hp_format_hms_runtime "$hp_rr_projected_seconds")"
    hp_rr_projection_margin="$(hp_format_signed_hms_runtime "$hp_rr_projection_margin")"
  fi

  printf 'STATUS: wall-elapsed=%s wall-remaining=%s cpu-used=%s disk=%s/%s cgroup-current=%s/%s output=%s expected-output-bytes=%s linear-progress=%s linear-projected-total=%s linear-projected-margin=%s\n' \
    "$(hp_format_hms_runtime "$hp_rr_elapsed_seconds")" \
    "$(hp_format_hms_runtime "$hp_rr_remaining_seconds")" \
    "$hp_rr_cgroup_cpu_current_usec" \
    "$(hp_format_gb_runtime "$hp_rr_disk_bytes")" \
    "$(hp_format_gb_runtime "$hp_rr_disk_limit_bytes")" \
    "$hp_rr_cgroup_current" \
    "$(hp_format_gib_runtime "$hp_rr_cgroup_limit_bytes")" \
    "$hp_rr_output_state" \
    "$hp_rr_expected_output_bytes" \
    "$hp_rr_progress" \
    "$hp_rr_projected_seconds" \
    "$hp_rr_projection_margin" >&2
}

hp_gnu_time_elapsed_seconds() {
  local hp_rr_time_file="$1"
  awk -F': ' '
    /Elapsed \(wall clock\) time/ {
      count = split($2, part, ":")
      if (count == 2) {
        printf "%.2f\n", part[1] * 60 + part[2]
      } else if (count == 3) {
        printf "%.2f\n", part[1] * 3600 + part[2] * 60 + part[3]
      }
    }
  ' "$hp_rr_time_file"
}

hp_inventory_runtime_executables() {
  local hp_rr_run_dir="$1"
  local hp_rr_report_file="$2"
  local hp_rr_staged_name="$3"
  local hp_rr_path hp_rr_relative hp_rr_role hp_rr_encoded
  {
    printf 'role\tpath_base64\tbytes\tsha256\n'
    while IFS= read -r -d '' hp_rr_path; do
      hp_rr_relative="${hp_rr_path#"$hp_rr_run_dir/"}"
      hp_rr_role=runtime-product
      [[ "$hp_rr_relative" != "$hp_rr_staged_name" ]] \
        || hp_rr_role=staged-root
      hp_rr_encoded="$(printf '%s' "$hp_rr_relative" | base64 --wrap=0)"
      printf '%s\t%s\t%s\t%s\n' "$hp_rr_role" "$hp_rr_encoded" \
        "$(stat --format='%s' -- "$hp_rr_path")" \
        "$(sha256sum -- "$hp_rr_path" | awk '{print $1}')"
    done < <(find -P "$hp_rr_run_dir" -type f -perm /111 -print0)
  } > "$hp_rr_report_file"
}
