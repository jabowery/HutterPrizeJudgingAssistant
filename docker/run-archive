#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C
umask 077
source /usr/local/lib/hutter-runtime-report

readonly expected_size="${EXPECTED_SIZE:-1000000000}"
readonly expected_output="${EXPECTED_OUTPUT:?EXPECTED_OUTPUT is required}"
readonly time_limit_seconds="${TIME_LIMIT_SECONDS:-192366}"
readonly memory_limit_bytes="${MEMORY_LIMIT_BYTES:-10737418240}"
readonly disk_limit_bytes="${DISK_LIMIT_BYTES:-100000000000}"
readonly disk_poll_seconds="${DISK_POLL_SECONDS:-10}"
readonly report_dir=/work/report
readonly run_dir=/work/run
readonly executable_name="${EXECUTABLE_NAME:?EXECUTABLE_NAME is required}"
readonly arguments_name="${ARGUMENTS_NAME:?ARGUMENTS_NAME is required}"
readonly runtime_exec_policy="${RUNTIME_EXEC_POLICY:-strict}"
readonly executable="$run_dir/$executable_name"

case "$expected_size:$time_limit_seconds:$memory_limit_bytes:$disk_limit_bytes:$disk_poll_seconds" in
  *[!0-9:]*|'')
    echo "Resource limits must be unsigned decimal integers." >&2
    exit 2
    ;;
esac
hp_runtime_policy_validate "$runtime_exec_policy"

if [[ ! "$expected_output" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "EXPECTED_OUTPUT must be a plain file name." >&2
  exit 2
fi

if [[ ! -x "$executable" || ! -f "$run_dir/$arguments_name" \
    || -L "$run_dir/$arguments_name" ]]; then
  echo "The staged executable or argument vector is invalid." >&2
  exit 2
fi
if [[ ! -r /proc/self/statm || ! -r /proc/self/maps \
    || ! -L /proc/self/exe ]]; then
  echo "The container-scoped procfs is unavailable." >&2
  exit 2
fi

write_report_value() {
  local name="$1"
  local value="$2"
  printf '%s\n' "$value" > "$report_dir/$name"
}

find_output() {
  local candidate
  candidate="$run_dir/$expected_output"
  if [[ -f "$candidate" && ! -L "$candidate" ]] \
      && [[ "$(stat --format='%s' -- "$candidate")" == "$expected_size" ]]; then
    printf '%s\n' "$expected_output"
    return 0
  fi
  return 1
}

readonly start_epoch="$(date +%s)"
readonly start_epoch_nanoseconds="$(date +%s%N)"
readonly deadline_epoch_nanoseconds="$((
  start_epoch_nanoseconds + time_limit_seconds * 1000000000
))"
write_report_value started_epoch "$start_epoch"
write_report_value deadline_epoch "$((deadline_epoch_nanoseconds / 1000000000))"
write_report_value time_limit_exceeded no
write_report_value time_limit_exceeded_epoch not_exceeded
write_report_value runtime_exec_policy "$runtime_exec_policy"
write_report_value procfs_scope container-pid-namespace
write_report_value procfs_contestant_access read-only-landlock
write_report_value supervisor_uid 0
write_report_value contestant_uid 65532
write_report_value landlock_abi \
  "$(/opt/contestant-root/bin/exec-once --landlock-probe \
      | awk -F= '$1 == "landlock_abi" {print $2}')"
cd "$run_dir"
mapfile -t executable_arguments < "$run_dir/$arguments_name"

hp_open_monitor_descriptors "$report_dir"
set +e
/usr/bin/time --verbose --output="$report_dir/time.txt" \
  /opt/contestant-root/bin/exec-once "$runtime_exec_policy" \
    9 8 7 6 "$memory_limit_bytes" /work/run \
    "./$executable_name" "${executable_arguments[@]}" \
  >"$report_dir/stdout.log" 2>"$report_dir/stderr.log" &
readonly timed_pid=$!
set -e

peak_disk_bytes=0
peak_apparent_bytes=0
resource_violation=none
time_limit_exceeded=no
time_limit_exceeded_epoch=not_exceeded

mark_time_limit_exceeded() {
  local completion_state="$1"
  [[ "$time_limit_exceeded" == no ]] || return 0
  time_limit_exceeded=yes
  time_limit_exceeded_epoch="$(date +%s)"
  resource_violation=time
  write_report_value time_limit_exceeded "$time_limit_exceeded"
  write_report_value time_limit_exceeded_epoch "$time_limit_exceeded_epoch"
  if [[ "$completion_state" == running ]]; then
    printf 'FAIL_TIME: %s exceeded its %s-second allowance and remains running; press Ctrl-C to terminate it.\n' \
      "$executable_name" "$time_limit_seconds" >&2
  else
    printf 'FAIL_TIME: %s completed after its %s-second allowance.\n' \
      "$executable_name" "$time_limit_seconds" >&2
  fi
}

mark_time_limit_if_due() {
  local current_epoch_nanoseconds
  [[ "$time_limit_exceeded" == no ]] || return 0
  current_epoch_nanoseconds="$(date +%s%N)"
  if (( current_epoch_nanoseconds >= deadline_epoch_nanoseconds )); then
    mark_time_limit_exceeded running
  fi
}

while kill -0 "$timed_pid" 2>/dev/null; do
  mark_time_limit_if_due
  current_disk_bytes="$(du --summarize --block-size=1 /work 2>/dev/null | awk '{print $1}')"
  current_apparent_bytes="$(du --summarize --bytes /work 2>/dev/null | awk '{print $1}')"
  current_disk_bytes="${current_disk_bytes:-0}"
  current_apparent_bytes="${current_apparent_bytes:-0}"

  if (( current_disk_bytes > peak_disk_bytes )); then
    peak_disk_bytes="$current_disk_bytes"
  fi
  if (( current_apparent_bytes > peak_apparent_bytes )); then
    peak_apparent_bytes="$current_apparent_bytes"
  fi

  if (( current_disk_bytes > disk_limit_bytes )); then
    resource_violation=disk
    kill -TERM "$timed_pid" 2>/dev/null || true
    sleep 2
    kill -KILL "$timed_pid" 2>/dev/null || true
    break
  fi

  mark_time_limit_if_due
  sleep_seconds="$disk_poll_seconds"
  if [[ "$time_limit_exceeded" == no ]]; then
    current_epoch_nanoseconds="$(date +%s%N)"
    remaining_nanoseconds="$((
      deadline_epoch_nanoseconds - current_epoch_nanoseconds
    ))"
    if (( remaining_nanoseconds <= 0 )); then
      continue
    fi
    remaining_seconds="$((
      (remaining_nanoseconds + 999999999) / 1000000000
    ))"
    if (( remaining_seconds < sleep_seconds )); then
      sleep_seconds="$remaining_seconds"
    fi
  fi
  sleep "$sleep_seconds"
done

set +e
wait "$timed_pid"
executable_exit_code=$?
set -e
hp_close_monitor_descriptors

readonly finish_epoch="$(date +%s)"
gnu_time_elapsed_seconds="$(hp_gnu_time_elapsed_seconds "$report_dir/time.txt")"
gnu_time_elapsed_seconds="${gnu_time_elapsed_seconds:-0.00}"
elapsed_seconds="$(awk -v elapsed="$gnu_time_elapsed_seconds" \
  'BEGIN { print int(elapsed + 0.999999) }')"
if [[ "$time_limit_exceeded" == no ]] \
    && awk -v elapsed="$gnu_time_elapsed_seconds" -v limit="$time_limit_seconds" \
      'BEGIN { exit !(elapsed > limit) }'; then
  mark_time_limit_exceeded completed
fi
gnu_time_peak_rss_kib="$(awk -F: '/Maximum resident set size/ {
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2
}' "$report_dir/time.txt")"
gnu_time_peak_rss_kib="${gnu_time_peak_rss_kib:-0}"
[[ "$gnu_time_peak_rss_kib" =~ ^[0-9]+$ ]] || gnu_time_peak_rss_kib=0
gnu_time_peak_rss_bytes="$((gnu_time_peak_rss_kib * 1024))"
process_tree_peak_rss_bytes="$(tr -d '\r\n' \
  < "$report_dir/process_tree_peak_rss_bytes")"
[[ "$process_tree_peak_rss_bytes" =~ ^[0-9]+$ ]] \
  || process_tree_peak_rss_bytes=0
process_tree_memory_exceeded="$(tr -d '\r\n' \
  < "$report_dir/process_tree_memory_exceeded")"
[[ "$process_tree_memory_exceeded" == yes ]] \
  || process_tree_memory_exceeded=no
peak_rss_bytes="$gnu_time_peak_rss_bytes"
(( process_tree_peak_rss_bytes <= peak_rss_bytes )) \
  || peak_rss_bytes="$process_tree_peak_rss_bytes"
peak_rss_kib="$((peak_rss_bytes / 1024))"
cgroup_peak_memory_bytes="$(hp_read_cgroup_peak)"
cgroup_peak_memory_source="$(hp_cgroup_peak_source)"

if [[ "$resource_violation" != disk \
    && "$process_tree_memory_exceeded" == yes ]]; then
  resource_violation=memory
elif [[ "$resource_violation" != disk \
    && "$peak_rss_bytes" -gt "$memory_limit_bytes" ]]; then
  resource_violation=memory
fi

final_disk_bytes="$(du --summarize --block-size=1 /work 2>/dev/null | awk '{print $1}')"
final_apparent_bytes="$(du --summarize --bytes /work 2>/dev/null | awk '{print $1}')"
final_disk_bytes="${final_disk_bytes:-0}"
final_apparent_bytes="${final_apparent_bytes:-0}"
if (( final_disk_bytes > peak_disk_bytes )); then
  peak_disk_bytes="$final_disk_bytes"
fi
if (( final_apparent_bytes > peak_apparent_bytes )); then
  peak_apparent_bytes="$final_apparent_bytes"
fi

write_report_value executable_exit_code "$executable_exit_code"
write_report_value elapsed_seconds "$elapsed_seconds"
write_report_value gnu_time_elapsed_seconds "$gnu_time_elapsed_seconds"
write_report_value finished_epoch "$finish_epoch"
write_report_value time_limit_exceeded "$time_limit_exceeded"
write_report_value time_limit_exceeded_epoch "$time_limit_exceeded_epoch"
write_report_value peak_disk_bytes "$peak_disk_bytes"
write_report_value peak_apparent_bytes "$peak_apparent_bytes"
write_report_value peak_rss_kib "$peak_rss_kib"
write_report_value peak_rss_bytes "$peak_rss_bytes"
write_report_value gnu_time_peak_rss_bytes "$gnu_time_peak_rss_bytes"
write_report_value cgroup_peak_memory_bytes "$cgroup_peak_memory_bytes"
write_report_value cgroup_peak_memory_source "$cgroup_peak_memory_source"
write_report_value resource_violation "$resource_violation"

if output_name="$(find_output)"; then
  write_report_value output_name "$output_name"
  stat --format='%s' -- "$run_dir/$output_name" > "$report_dir/output.bytes"
  sha256sum -- "$run_dir/$output_name" | awk '{print $1}' > "$report_dir/output.sha256"
  write_report_value output_status found
else
  write_report_value output_status missing_or_ambiguous
fi

hp_inventory_runtime_executables "$run_dir" \
  "$report_dir/runtime-executables.tsv" "$executable_name"

chmod 0444 "$report_dir"/*
chmod 0555 "$report_dir"

exit "$executable_exit_code"
